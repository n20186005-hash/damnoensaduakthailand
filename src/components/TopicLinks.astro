---
import { getI18n } from '../i18n/ui';

const { lang } = Astro.props;
const { t, messages } = await getI18n(Astro.url);
const topics = messages.topics;

const slugFor: Record<string, string> = {
  openingHours: 'opening-hours',
  boatPrices: 'boat-prices',
  fromBangkok: 'from-bangkok',
  avoidScams: 'avoid-scams',
  maeklongDayTrip: 'maeklong-day-trip',
};

const order = ['openingHours', 'boatPrices', 'fromBangkok', 'avoidScams', 'maeklongDayTrip'];
---

<section class="max-w-5xl mx-auto px-4 py-12">
  <h2 class="text-2xl sm:text-3xl font-bold text-ink">{t('topicGuides.title')}</h2>
  <p class="text-stone-600 mt-3 max-w-2xl">{t('topicGuides.subtitle')}</p>
  <div class="mt-6 grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
    {order.map((k) => (
      <a
        href={`/${lang}/${slugFor[k]}/`}
        class="group rounded-2xl border border-stone-200 bg-white p-5 hover:border-teak transition"
      >
        <h3 class="font-semibold text-ink group-hover:text-teak">{topics[k].title}</h3>
        <p class="text-sm text-stone-600 mt-2 leading-relaxed">{topics[k].metaDescription}</p>
        <span class="mt-3 inline-block text-teak text-sm font-medium">→</span>
      </a>
    ))}
  </div>
</section>
