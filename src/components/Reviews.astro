---
import { getI18n } from '../i18n/ui';
import { siteConfig } from '../config';

const { t } = await getI18n(Astro.url);

const stars = Math.round(Number(siteConfig.rating) * 2) / 2;
const full = Math.floor(stars);
const half = stars - full >= 0.5;
---

<section id="reviews" class="max-w-5xl mx-auto px-4 py-12">
  <p class="text-sm font-semibold tracking-widest text-teak uppercase">{t('reviews.label')}</p>
  <h2 class="text-2xl sm:text-3xl font-bold text-ink mt-2">{t('reviews.heading')}</h2>
  <p class="text-stone-600 mt-3 max-w-2xl">{t('reviews.intro')}</p>

  <div class="mt-6 flex flex-col sm:flex-row sm:items-center gap-6 rounded-2xl border border-stone-200 bg-white p-6">
    <div class="flex items-center gap-2" aria-hidden="true">
      {Array.from({ length: full }).map(() => (
        <svg class="w-7 h-7 text-amber-400" viewBox="0 0 24 24" fill="currentColor"><path d="M12 17.3 6.2 20.5l1.1-6.5L2.3 9.4l6.5-.9L12 2.6l3.2 5.9 6.5.9-5 4.6 1.1 6.5z"/></svg>
      ))}
      {half && (
        <svg class="w-7 h-7 text-amber-400" viewBox="0 0 24 24" fill="currentColor"><path d="M12 2.6l3.2 5.9 6.5.9-5 4.6 1.1 6.5L12 17.3 6.2 20.5l1.1-6.5L2.3 9.4l6.5-.9z" opacity="0.35"/><path d="M12 2.6l3.2 5.9 6.5.9-5 4.6 1.1 6.5L12 17.3z"/></svg>
      )}
    </div>
    <div>
      <div class="text-3xl font-bold text-ink">{siteConfig.rating}<span class="text-lg font-normal text-stone-500"> / 5</span></div>
      <div class="text-sm text-stone-500">{t('reviews.ratingLabel')}</div>
    </div>
    <div class="sm:ml-auto text-sm text-stone-500">{t('reviews.sourceLabel')} · {siteConfig.reviewCount}</div>
  </div>

  <p class="text-xs text-stone-500 mt-3">{t('reviews.note')}</p>

  <a
    href={siteConfig.mapsUrl}
    target="_blank"
    rel="noopener noreferrer"
    class="mt-4 inline-flex items-center gap-1 text-teak font-medium hover:underline"
  >
    {t('reviews.viewLocation')}
  </a>
</section>
