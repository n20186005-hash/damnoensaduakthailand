---
interface Props {
  messages: Record<string, any>;
}
const { messages } = Astro.props;
const r = messages.routes;
const general = [r.halfDay, r.fullDay];
---

<section id="routes" class="py-20 bg-ivory text-ink">
  <div class="max-w-7xl mx-auto px-5">
    <p class="font-hand text-gold text-xl md:text-2xl">{r.label}</p>
    <h2 class="font-display font-semibold text-3xl md:text-5xl text-teak mt-2">{r.heading}</h2>
    <p class="mt-5 text-ink/80 max-w-3xl">{r.lead}</p>

    <!-- General itineraries: half day / full day -->
    <h3 class="font-display text-2xl text-teak mt-12 pb-3 border-b border-gold/30">{r.generalTitle}</h3>
    <div class="grid lg:grid-cols-2 gap-6 mt-8">
      {general.map((plan: any, idx: number) => (
        <article class={`rounded-2xl p-7 ${idx === 0 ? 'bg-teak text-ivory' : 'bg-teakDeep text-ivory'}`}>
          <div class="flex items-baseline justify-between gap-4">
            <h4 class="font-display text-2xl text-goldBright">{plan.title}</h4>
            <span class="text-xs uppercase tracking-wider text-ivory/60 whitespace-nowrap">
              {plan.duration}
            </span>
          </div>
          <p class="mt-3 text-sm text-ivory/70">
            <span class="text-gold">{r.forLabel}:</span> {plan.for}
          </p>
          <p class="mt-1 text-sm text-ivory/70">
            <span class="text-gold">{r.focusLabel}:</span> {plan.focus}
          </p>

          <div class="text-xs uppercase tracking-wider text-gold mt-6 mb-3">{r.stepsLabel}</div>
          <ol class="space-y-3">
            {plan.steps.map((step: string, i: number) => (
              <li class="flex gap-3 text-sm text-ivory/85">
                <span class="font-display text-gold/70 shrink-0">{String(i + 1).padStart(2, '0')}</span>
                <span>{step}</span>
              </li>
            ))}
          </ol>

          <p class="mt-6 rounded-xl bg-gold/15 border border-gold/30 px-4 py-3 text-sm text-goldBright">
            {plan.tip}
          </p>
        </article>
      ))}
    </div>

    <!-- Classic combined day trip: Damnoen Saduak + Maeklong Railway Market -->
    {r.maeklong && (
      <>
        <h3 class="font-display text-2xl text-teak mt-16 pb-3 border-b border-gold/30">{r.comboTitle}</h3>
        <p class="mt-4 text-ink/75 text-base max-w-4xl leading-relaxed">{r.comboLead}</p>

        <div class="mt-8 grid lg:grid-cols-12 gap-6">
          <aside class="lg:col-span-4 rounded-2xl border border-gold/30 bg-white/50 p-6">
            <p class="font-hand text-gold text-lg">{r.maeklong.distanceTitle}</p>
            <p class="mt-2 text-ink/75 text-sm leading-relaxed">{r.maeklong.about}</p>
            <dl class="mt-4 space-y-3 text-sm">
              <div class="flex gap-2 border-b border-gold/15 pb-2">
                <dt class="text-teak/70 shrink-0">Driving</dt>
                <dd class="text-ink">{r.maeklong.distance}</dd>
              </div>
              <div class="flex gap-2 border-b border-gold/15 pb-2">
                <dt class="text-teak/70 shrink-0">{r.maeklong.timingTag}</dt>
                <dd class="text-ink">{r.maeklong.timingTip}</dd>
              </div>
            </dl>
          </aside>

          <article class="lg:col-span-8 rounded-2xl p-7 bg-teak text-ivory">
            <div class="flex items-baseline justify-between gap-4 flex-wrap">
              <h4 class="font-display text-2xl text-goldBright">{r.maeklong.fullCombo.title}</h4>
              <span class="text-xs uppercase tracking-wider text-ivory/60 whitespace-nowrap">
                {r.maeklong.fullCombo.duration}
              </span>
            </div>
            <p class="mt-3 text-sm text-ivory/70">
              <span class="text-gold">{r.forLabel}:</span> {r.maeklong.fullCombo.for}
            </p>
            <p class="mt-1 text-sm text-ivory/70">
              <span class="text-gold">{r.focusLabel}:</span> {r.maeklong.fullCombo.focus}
            </p>

            <div class="text-xs uppercase tracking-wider text-gold mt-6 mb-3">{r.stepsLabel}</div>
            <ol class="space-y-3">
              {r.maeklong.fullCombo.steps.map((step: string, i: number) => (
                <li class="flex gap-3 text-sm text-ivory/85">
                  <span class="font-display text-gold/70 shrink-0">{String(i + 1).padStart(2, '0')}</span>
                  <span>{step}</span>
                </li>
              ))}
            </ol>

            <p class="mt-6 rounded-xl bg-gold/15 border border-gold/30 px-4 py-3 text-sm text-goldBright">
              {r.maeklong.fullCombo.tip}
            </p>
          </article>
        </div>
      </>
    )}

    <!-- Itineraries by traveller type -->
    <h3 class="font-display text-2xl text-teak mt-16 pb-3 border-b border-gold/30">{r.audienceTitle}</h3>
    <p class="mt-4 text-ink/70 text-sm max-w-3xl">{r.audienceLead}</p>
    <div class="grid lg:grid-cols-3 gap-6 mt-8">
      {r.audiences.map((a: any) => (
        <article class="rounded-2xl border border-gold/35 bg-white/50 p-6 flex flex-col">
          <div class="flex items-center gap-3">
            <span class="text-3xl" aria-hidden="true">{a.icon}</span>
            <div>
              <span class="font-display text-gold/70 text-sm">{a.tag}</span>
              <h4 class="font-display text-xl text-teak leading-snug">{a.title}</h4>
            </div>
          </div>

          <dl class="mt-5 space-y-1 text-sm">
            <div class="flex gap-2">
              <dt class="text-teak/60 shrink-0">{r.durationLabel}:</dt>
              <dd class="text-ink/80">{a.duration}</dd>
            </div>
            <div class="flex gap-2">
              <dt class="text-teak/60 shrink-0">{r.focusLabel}:</dt>
              <dd class="text-ink/80">{a.focus}</dd>
            </div>
          </dl>

          <ul class="mt-5 space-y-2.5 text-sm text-ink/80 grow">
            {a.steps.map((step: string, i: number) => (
              <li class="flex gap-2.5">
                <span class="text-gold shrink-0">·</span>
                <span>{step}</span>
              </li>
            ))}
          </ul>

          <p class="mt-5 rounded-xl bg-teak/10 border border-teak/15 px-4 py-3 text-sm text-teak">
            {a.tip}
          </p>
        </article>
      ))}
    </div>
  </div>
</section>
