---
import '../styles/global.css';
import { siteConfig } from '../config';
import { htmlLang, languagesList, type Lang } from '../i18n/ui';

interface Props {
  lang: Lang;
  title: string;
  description: string;
  noindex?: boolean;
  faqList?: Array<{ q: string; a: string }>;
}
const { lang, title, description, noindex = false, faqList = [] } = Astro.props;

const rawPath = Astro.url.pathname;
const normalizedPath = rawPath.endsWith('/') ? rawPath : rawPath + '/';
const canonical = `${siteConfig.domain}${normalizedPath}`;

const buildAlternateUrl = (targetLang: Lang) => {
  const parts = normalizedPath.split('/').filter(Boolean);
  if (parts.length > 0 && (languagesList as readonly string[]).includes(parts[0])) {
    parts[0] = targetLang;
  }
  const path = parts.join('/');
  return `${siteConfig.domain}/${path}${path ? '/' : ''}`;
};

const touristAttractionLd = {
  '@context': 'https://schema.org',
  '@type': ['TouristAttraction', 'Market'],
  name: siteConfig.name[lang],
  alternateName: lang === 'th'
    ? siteConfig.name.en
    : lang === 'zh'
    ? siteConfig.name.en
    : siteConfig.name.th,
  description,
  image: `${siteConfig.domain}/gallery/damnoen-saduak-floating-market-1.jpg`,
  url: canonical,
  telephone: siteConfig.phone,
  priceRange: '$$',
  additionalType: siteConfig.category[lang],
  address: {
    '@type': 'PostalAddress',
    streetAddress: siteConfig.postalAddress.streetAddress[lang],
    addressLocality: siteConfig.postalAddress.addressLocality[lang],
    addressRegion: siteConfig.postalAddress.addressRegion[lang],
    postalCode: siteConfig.postalAddress.postalCode,
    addressCountry: siteConfig.postalAddress.addressCountry,
  },
  geo: {
    '@type': 'GeoCoordinates',
    latitude: siteConfig.coords.lat,
    longitude: siteConfig.coords.lng,
  },
  hasMap: siteConfig.mapsUrl,
  openingHoursSpecification: [
    {
      '@type': 'OpeningHoursSpecification',
      dayOfWeek: ['Monday', 'Tuesday', 'Wednesday', 'Thursday', 'Friday', 'Saturday', 'Sunday'],
      opens: '07:00',
      closes: '17:00',
    },
  ],
  additionalProperty: [
    {
      '@type': 'PropertyValue',
      name: 'Plus Code',
      value: siteConfig.plusCode,
    },
    {
      '@type': 'PropertyValue',
      name: 'Province',
      value: siteConfig.province[lang],
    },
  ],
  sameAs: siteConfig.sameAs,
};

const defaultFaqs = [
  {
    '@type': 'Question' as const,
    name: '哪天去最好？ / Best day to visit?',
    acceptedAnswer: {
      '@type': 'Answer' as const,
      text: '工作日比周末人少，破晓时分最能感受原汁原味的氛围。/ Weekdays are less crowded. Early morning offers the most authentic experience.'
    }
  },
  {
    '@type': 'Question' as const,
    name: '需要提前订船吗？ / Need to book a boat in advance?',
    acceptedAnswer: {
      '@type': 'Answer' as const,
      text: '多数可在码头现场租到，但节假日建议预订。/ Mostly available on-site, but booking is recommended on holidays.'
    }
  }
];

const faqMainEntity = faqList.length > 0
  ? faqList.map((f) => ({
      '@type': 'Question' as const,
      name: f.q,
      acceptedAnswer: {
        '@type': 'Answer' as const,
        text: f.a,
      },
    }))
  : defaultFaqs;

const faqPageLd = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faqMainEntity,
};

const jsonLd = noindex ? [] : [touristAttractionLd, faqPageLd];
---

<!doctype html>
<html lang={htmlLang[lang]}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/jpeg" href={`/gallery/damnoen-saduak-floating-market-1.jpg`} />
    <title>{title}</title>
    <meta name="description" content={description} />
    {noindex && <meta name="robots" content="noindex, follow" />}
    <link rel="canonical" href={canonical} />
    <meta property="og:type" content="website" />
    <meta property="og:locale" content={htmlLang[lang]} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={`${siteConfig.domain}/gallery/damnoen-saduak-floating-market-1.jpg`} />
    <meta property="og:url" content={canonical} />
    <meta name="twitter:card" content="summary_large_image" />
    {languagesList.map((l) => (
      <link rel="alternate" hreflang={htmlLang[l]} href={buildAlternateUrl(l)} />
    ))}
    <link rel="alternate" hreflang="x-default" href={buildAlternateUrl('en')} />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Trirong:ital,wght@0,400;0,500;0,600;0,700;1,500&family=Sarabun:wght@300;400;500;600;700&family=Charm:wght@400;700&family=Noto+Sans+SC:wght@300;400;500;700&display=swap"
      rel="stylesheet"
    />
    <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />

    <!-- Google tag (gtag.js) -->
    <script async src="https://www.googletagmanager.com/gtag/js?id=G-HXM22WWPKP"></script>
    <script>
      window.dataLayer = window.dataLayer || [];
      window.gtag = function () {
        window.dataLayer.push(arguments);
      };
      window.gtag('js', new Date());
      window.gtag('config', 'G-HXM22WWPKP');
    </script>
  </head>
  <body class="grain">
    <slot />
  </body>
</html>
